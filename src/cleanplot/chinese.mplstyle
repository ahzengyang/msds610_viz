# cleanplot — the "chinese" theme (中国风).
#
# A matplotlib style sheet with a traditional Chinese ink-and-paper aesthetic:
# a warm rice-paper background, ink-colored type and spines, faint warm
# gridlines, and a color cycle drawn from traditional Chinese colors with
# china red as the accent. Registered as "cleanplot-chinese":
#
#     import cleanplot
#     import matplotlib.pyplot as plt
#     plt.style.use("cleanplot-chinese")
#
# It keeps the same data-ink discipline as the default theme (no top/right
# spines, light grid, legible type) — only the palette and surfaces change.

# --- figure (rice-paper surfaces) --------------------------------------------
figure.figsize:  8.0, 5.0
figure.dpi:      110
figure.facecolor: F7F2E7
axes.facecolor:   F7F2E7
savefig.dpi:      200
savefig.bbox:     tight
savefig.facecolor: F7F2E7

# --- typography --------------------------------------------------------------
font.size:       11
axes.titlesize:  14
axes.labelsize:  11.5
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

# --- Chinese / CJK text support (so Chinese labels also render) --------------
font.family:       sans-serif
font.sans-serif:   Microsoft YaHei, PingFang SC, Hiragino Sans GB, Heiti SC, Noto Sans CJK SC, Source Han Sans SC, WenQuanYi Zen Hei, SimHei, Arial Unicode MS, DejaVu Sans
axes.unicode_minus: False

# --- color cycle (traditional Chinese colors, china red first) ---------------
axes.prop_cycle: cycler('color', ['C1272D', '1E6A8C', '5A8F5A', 'E0A32E', '6E5773', 'A6572F', '7BA9A0', '33312B'])

# --- data-ink: spines (ink) --------------------------------------------------
axes.spines.top:   False
axes.spines.right: False
axes.edgecolor:    33312B
axes.linewidth:    0.8

# --- data-ink: title / label placement ---------------------------------------
axes.titlelocation: left
axes.titlepad:      12.0
axes.titleweight:   bold
axes.labelpad:      6.0
axes.labelcolor:    33312B
text.color:         33312B

# --- data-ink: gridlines (faint, warm, y-only, behind the data) --------------
axes.grid:       True
axes.grid.axis:  y
axes.axisbelow:  True
grid.color:      DDD5C4
grid.linewidth:  0.8
grid.linestyle:  -

# --- data-ink: ticks (invisible marks, ink labels) ---------------------------
xtick.color:      33312B
ytick.color:      33312B
xtick.major.size: 0.0
ytick.major.size: 0.0
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.major.pad:  6.0
ytick.major.pad:  6.0

# --- legend ------------------------------------------------------------------
legend.frameon:        False
legend.borderaxespad:  0.0
